# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files — never commit secrets; keep the placeholder file
.env
.env.*
!.env.example

# local database files
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql.gz
dump.rdb

# runtime / application data (lives outside this Git repo)
/data/
data/
uploads/
public/uploads/

# secrets and private keys
secrets/
*.secret
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.crt

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Server migration backups
.port-migration-backup-*/
.port-migration-backup-latest
