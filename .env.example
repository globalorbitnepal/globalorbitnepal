# GlobalOrbitNepal — placeholders only. Copy to a server-local .env (never commit).
# This project must NOT use HostingBeyond DATABASE_URL, roles, or data directories.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1

# PostgreSQL — dedicated GlobalOrbitNepal database and role only.
# Expected database: globalorbitnepal_db
# Expected role:     globalorbitnepal_app
# Host must be local. Do not point this at hostingbeyond_db or hostingbeyond_user.
DATABASE_URL="postgresql://globalorbitnepal_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/globalorbitnepal_db?schema=public"

# Uploads live outside the Git repository.
UPLOAD_DIR=/data/globalorbitnepal/uploads

# Public canonical origin (no trailing slash). Used for sitemap, robots, OG, JSON-LD.
# Staging VPS:     https://arnav.theglobalorbit.com
# Apex cutover:    https://theglobalorbit.com
# WARNING: theglobalorbit.com currently serves a different property — only set the
# apex value after DNS/cutover is authorized and this app is the apex destination.
NEXT_PUBLIC_SITE_URL=https://arnav.theglobalorbit.com

# Orbit /admin dashboard (server .env only — never commit the real value).
ORBIT_EDITOR_USERNAME=
ORBIT_EDITOR_PASSWORD=
