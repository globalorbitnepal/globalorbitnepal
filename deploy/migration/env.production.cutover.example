# =============================================================================
# Global Orbit — PRODUCTION CUTOVER env fragment
# =============================================================================
# DO NOT apply until DNS/nginx/TLS cutover is explicitly authorized.
# DO NOT commit a real .env with secrets.
#
# Copy the SITE_URL line into the server-local .env (outside git), then REBUILD.
# NEXT_PUBLIC_* is inlined at build time — restart alone is not enough.
#
# Staging (current live):
#   NEXT_PUBLIC_SITE_URL=https://arnav.theglobalorbit.com
#   (or omit — lib/site-origin.ts falls back to arnav)
#
# Production (authorized cutover only):
NEXT_PUBLIC_SITE_URL=https://theglobalorbit.com
#
# Leave these unchanged unless operators intentionally move them:
#   DATABASE_URL=...          # existing globalorbitnepal_db only
#   UPLOAD_DIR=/data/globalorbitnepal/uploads
#   ORBIT_EDITOR_USERNAME=...
#   ORBIT_EDITOR_PASSWORD=...
#
# After setting SITE_URL:
#   npm run build
#   pm2 restart globalorbitnepal
#   BASE_URL=https://theglobalorbit.com npm run migration:validate
# =============================================================================
