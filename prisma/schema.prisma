generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NavLocation {
  HEADER
  FOOTER
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

/// Singleton-style site configuration. Application code should keep a single row
/// keyed by singletonKey = "default".
model SiteSettings {
  id              String   @id @default(cuid())
  singletonKey    String   @unique @default("default")
  companyName     String
  tagline         String   @default("")
  email           String
  phone           String   @default("")
  address         String   @default("")
  facebookUrl     String?
  instagramUrl    String?
  linkedinUrl     String?
  xUrl            String?
  youtubeUrl      String?
  whatsappUrl     String?
  defaultSeoTitle String   @default("")
  defaultSeoDescription String @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NavItem {
  id        String      @id @default(cuid())
  label     String
  href      String
  location  NavLocation
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, sortOrder])
  @@index([isVisible])
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String   @default("")
  body           String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String   @default("")
  body        String   @default("")
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model Post {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String    @default("")
  body          String    @default("")
  featuredImage String?
  publishedAt   DateTime?
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// File metadata only. Binary files live under /data/globalorbitnepal/uploads.
model MediaAsset {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  path         String
  altText      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}
